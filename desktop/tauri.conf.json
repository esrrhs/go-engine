{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "divvy",
  "version": "0.1.0",
  "identifier": "com.divvy.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "node scripts/dev.mjs",
      "cwd": "."
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../web"
    },
    "beforeBundleCommand": {
      "script": "node scripts/build-sidecar.mjs",
      "cwd": "."
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "dev": "default-src 'self'; connect-src 'self' ws://localhost:5173 http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:",
        "release": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/divvy-sidecar"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
